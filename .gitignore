# Mutation testing
mutants/
mutants-*/
mutmut-results/
.mutmut-cache
.mutmut_current_phase

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments — .venv-check is a symlink to .venv (see
# dev/setup.sh), covered by the same pattern since the glob matches the
# symlink name itself, not what it points to.
.venv/
.venv-check

# Type checking
.mypy_cache/
.ruff_cache/

# Test infrastructure
.hypothesis/
.coverage
htmlcov/
.pytest_cache/

# Test reports (generated at runtime into /config/www/)
nibe_test_report.html

# Local secrets and runtime data — never commit these
data/
/data/

# Local secrets and env vars — never commit these
.env

# Local reference firmware data dumps — not committed, developer-local only
/reference-dumps/

# Claude Code project config — kept local-only
.claude/

# macOS
.DS_Store
.smb*

# Editor / IDE — settings.json and extensions.json are shared project
# config (Ruff/mypy/interpreter setup, recommended extensions), not
# personal preference, so they're carved out below and actually committed.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/schemas/
!.vscode/schemas/*.json
.idea/
*.swp
*.swo

# Build outputs
*.egg-info/
dist/
build/

# JS test tooling (app/) — Vitest + Playwright for nibe-entity-manager-card.js
app/node_modules/
app/coverage/
app/test-results/
app/playwright-report/
app/.vitest-cache/
