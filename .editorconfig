# Editor-agnostic baseline — .vscode/settings.json covers the same ground
# for VS Code specifically (plus Ruff/ESLint's own formatting, which this
# does not duplicate); this is for anyone using a different editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
# No max_line_length here — Ruff already owns this (ruff.toml's
# line-length = 100) and applies it more accurately than a naive
# character-count check: docstrings/comments legitimately exceed 100
# chars in places Ruff doesn't hard-fail on, and a flat editorconfig rule
# would just create noise disagreeing with the tool that actually decides.

[*.{js,mjs,cjs,ts,json}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
