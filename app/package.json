{
  "name": "nibe-entity-manager-card-tests",
  "private": true,
  "type": "module",
  "description": "Test tooling for nibe-entity-manager-card.js (Vitest + jsdom unit/integration tests, Playwright smoke tests). Scoped to app/ and independent of the repo's Python pytest suite.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.7"
  }
}
